<!DOCTYPE html>
<html>
<head>
    <title>studySpartan Home</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

    <header class="header">
        <h4>studySpartan</h4>
        <nav>
            <a href="/">Home</a>
            <a href="/services/view">Services</a>
            <a href="/students/create">Register</a>
            <a href="/reviews/new">Write Review</a>
            <a href="/reviews">Reviews</a>
        </nav>
    </header>

    <main>
        <section class="card" style="text-align: center;">
            <span class="badge">Student Support Platform</span>
            <div class="page-title">
                <h1>Welcome to studySpartan</h1>
                <p>Helping students connect with tutoring services more easily.</p>
            </div>

            <p style="font-size: 18px; max-width: 720px; margin: 0 auto 30px; line-height: 1.7;">
                studySpartan gives students access to tutoring in math, programming, physics, writing, and more.
                Browse services, subscribe to support, and stay on track academically.
            </p>

            <a href="/services/view" class="subscribe-btn">Explore Services</a>
            <a href="/reviews" class="subscribe-btn">View Reviews</a>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 studySpartan. All rights reserved.</p>
    </footer>

</body>
</html>